<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Permisos de red ──────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Permisos biométricos ──────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- ── Cámara (vista AR del aura) ─────────────────────────────────────
         Lo declara también unityLibrary, pero se explicita aquí porque el
         host es quien debe pedirlo en runtime: el manifest de Unity trae
         unityplayer.SkipPermissionsDialog=true, o sea que Unity NO lo pide. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".SakuraApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sakura"
        >
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Sakura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- unityLibrary declara UnityPlayerActivity como LAUNCHER exportada,
             lo que dejaba DOS íconos de la app en el drawer. Se conserva la
             activity (la necesitamos para la vista AR) pero sin su launcher. -->
        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>

        <!-- Vista 3D del aura. Hereda de UnityPlayerActivity, así que necesita
             el mismo theme y configChanges: sin ellos Unity se reinicia al
             rotar o al cambiar de tamaño la ventana.

             process=":unityplayer": Unity as a Library MATA su proceso al
             destruirse la activity (UnityPlayer.destroy → killProcess). En el
             proceso principal eso cerraba la app entera al pulsar "atrás".
             Aislado aquí, solo muere Unity y la app queda intacta debajo. -->
        <activity
            android:name="com.sakura.aura.unity.AuraUnityActivity"
            android:exported="false"
            android:process=":unityplayer"
            android:theme="@style/UnityThemeSelector"
            android:screenOrientation="fullSensor"
            android:launchMode="singleTask"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:resizeableActivity="false"
            android:hardwareAccelerated="false">
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>

        <!-- Cámara con filtro. Mismas condiciones que la vista del aura: hereda
             de UnityPlayerActivity y comparte el proceso ":unityplayer".

             Comparte proceso a propósito: Unity as a Library solo admite UN
             UnityPlayer vivo, así que aura y filtro nunca deben coexistir. Al
             estar en el mismo proceso con launchMode singleTask, abrir una
             mientras la otra vive reutiliza el runtime en vez de intentar
             levantar un segundo player (que reventaría). -->
        <activity
            android:name="com.sakura.aura.unity.FiltroUnityActivity"
            android:exported="false"
            android:process=":unityplayer"
            android:theme="@style/UnityThemeSelector"
            android:screenOrientation="fullSensor"
            android:launchMode="singleTask"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:resizeableActivity="false"
            android:hardwareAccelerated="false">
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>
    </application>

</manifest>